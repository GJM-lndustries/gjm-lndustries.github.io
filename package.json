{
  "name": "proicfes",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "ProICFES: app web interactiva para preparar el examen Saber 11 (ICFES).",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build && node scripts/postbuild.mjs",
    "preview": "vite preview --host",
    "check": "tsc --noEmit",
    "validate:questions": "tsx scripts/validate-questions.ts",
    "test": "vitest run",
    "format": "prettier --write ."
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "framer-motion": "^12.23.22",
    "lucide-react": "^0.453.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "recharts": "^2.15.2",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "wouter": "^3.7.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/node": "^24.7.0",
    "@types/react": "^19.2.1",
    "@types/react-dom": "^19.2.1",
    "@vitejs/plugin-react": "^5.0.4",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.19.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.6.3",
    "vite": "^7.1.7",
    "vitest": "^3.2.4"
  },
  "packageManager": "pnpm@10.33.4",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
